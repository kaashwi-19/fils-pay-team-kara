# The merchant dashboard (apps/web), built once and served by nginx on port 80.
# nginx also forwards /v1 and /healthz to the api container, so the browser
# talks to ONE origin: session cookies just work and no CORS is needed.
FROM node:20-bookworm AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --no-audit --no-fund
COPY . .
# Empty base URL = same origin as the page (nginx proxies /v1 to the api).
RUN VITE_API_BASE_URL= npm run build -w apps/web

FROM nginx:1.27-alpine
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
