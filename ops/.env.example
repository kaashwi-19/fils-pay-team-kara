# Copy to ops/.env (gitignored) and fill in real values before
# `docker compose -f ops/docker-compose.yml up`.
#
# Generate random values with:  openssl rand -hex 32   /   openssl rand -base64 32
SETTLEMENT_INTERNAL_TOKEN=
# Must base64-decode to exactly 32 bytes (openssl rand -base64 32)
WEBHOOK_SECRET_ENCRYPTION_KEY=
ACQUIRER_CALLBACK_SIGNING_SECRET=
